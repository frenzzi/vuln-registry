# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Ключ подписи JWT, не короче 32 байт. Без него приложение не запускается.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Время жизни токена, минут
APP_TOKEN_TTL_MINUTES=60

# Строка подключения к БД
APP_DATABASE_URL=sqlite:///./vuln_registry.db

# Режим отладки: автоперезагрузка, подробный лог, пароли сида по умолчанию
APP_DEBUG=false

APP_HOST=127.0.0.1
APP_PORT=8000

# Пароли демо-пользователей для python -m app.db.seed.
# Значения по умолчанию подставляются только при APP_DEBUG=true.
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_OWNER1_PASSWORD=
SEED_OWNER2_PASSWORD=
